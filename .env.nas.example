# Copy to .env.nas on the NAS. Never commit the populated file.
# Use the immutable sha-* tag printed by the Publish NAS image workflow.
COVENANT_IMAGE=ghcr.io/baypeline/covenant-watch:sha-REPLACE_WITH_COMMIT
COVENANT_DATA_DIR=/volume1/docker/covenant-watch
COVENANT_BIND_ADDRESS=127.0.0.1
COVENANT_WEB_PORT=9923

MIDNIGHT_WALLET_SEED=
MIDNIGHT_PRIVATE_STATE_PASSWORD=
MIDNIGHT_CONTRACT_ADDRESS=

# Leave operator HTTP disabled on a public deployment.
COVENANT_ENABLE_OPERATOR_HTTP=false
COVENANT_OPERATOR_TOKEN=

# Required only when the optional tunnel profile is started.
CLOUDFLARE_TUNNEL_TOKEN=
